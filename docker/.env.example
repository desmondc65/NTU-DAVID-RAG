# Copy to `.env` and tweak if defaults don't fit.
#
# External port for the unified dashboard (landing + /rag/ + /graph/).
UNIFIED_PORT=3006

# Physical GPU index for the embedding server (loads the 7B embedder in
# fp16 on this single GPU). All other stack containers run on CPU.
EMBEDDING_GPU=1

# Physical GPU index for rag-web's MinerU (PDF layout/OCR) during ingestion.
# Falls back to EMBEDDING_GPU when unset. Set to a different index when the
# embedder's card doesn't have enough free VRAM (~5 GB) for MinerU.
RAG_WEB_GPU=0

# Cap for MinerU's auto-tuned batch size. Its default reads the GPU's TOTAL
# vram and picks 16 for any ≥32 GB card, which OOMs on a shared GPU.
# Suggested values: 8 (~5 GB working set), 4 (~3 GB), 2, 1.
MINERU_HYBRID_BATCH_RATIO=8

# Optional model overrides — must match what was used to populate the DBs.
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-7B-instruct
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=8

# ── Single-GPU mode (docker-compose.one-gpu.yml) ─────────────────────────
# Optional. Only consumed when you bring the stack up with ./up.one-gpu.sh
# (or `-f docker-compose.yml -f docker-compose.one-gpu.yml`). That override
# runs the embedder, reranker, LLM and MinerU all on one card. See
# README.one-gpu.md — note the embedder change rebuilds your vector DBs.
#   GPU                     physical card for the whole stack (default 0)
#   ONE_GPU_EMBEDDING_MODEL default google/embeddinggemma-300m  (768-dim)
#   ONE_GPU_LLM_MODEL       default gemma3:12b-it-qat  (int4, via Ollama)
#   HF_TOKEN                required — embeddinggemma is gated on HF
#GPU=0
#ONE_GPU_EMBEDDING_MODEL=google/embeddinggemma-300m
#ONE_GPU_LLM_MODEL=gemma3:12b-it-qat
#HF_TOKEN=

# ── Auth / chat-history database (Postgres) ──────────────────────────────
AUTH_DB_NAME=appdb
AUTH_DB_USER=appuser
# Use something long + random in production. `openssl rand -hex 24` is fine.
AUTH_DB_PASSWORD=change-me-long-random-string

# Server-side session signing / CSRF secret. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Flip to false once bootstrap accounts exist to disable open signup.
ALLOW_REGISTRATION=true

# In production behind HTTPS, set to true so cookies get the Secure flag.
SESSION_COOKIE_SECURE=false
