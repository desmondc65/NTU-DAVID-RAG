# Copy to `.env` and tweak if defaults don't fit.
#
# External port for the unified dashboard (landing + /rag/ + /graph/).
UNIFIED_PORT=3006

# Physical GPU index the embedding server should own. All other stack
# containers run on CPU because embedding is the only GPU-heavy step.
EMBEDDING_GPU=1

# Optional model overrides — must match what was used to populate the DBs.
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-7B-instruct
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=8
