# Copy to `.env` and tweak if defaults don't fit.
#
# External port for the unified dashboard (landing + /rag/ + /graph/).
UNIFIED_PORT=3006

# Physical GPU index the embedding server should own. All other stack
# containers run on CPU because embedding is the only GPU-heavy step.
EMBEDDING_GPU=1

# Optional model overrides — must match what was used to populate the DBs.
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-7B-instruct
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=8

# ── Auth / chat-history database (Postgres) ──────────────────────────────
AUTH_DB_NAME=appdb
AUTH_DB_USER=appuser
# Use something long + random in production. `openssl rand -hex 24` is fine.
AUTH_DB_PASSWORD=change-me-long-random-string

# Server-side session signing / CSRF secret. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Flip to false once bootstrap accounts exist to disable open signup.
ALLOW_REGISTRATION=true

# In production behind HTTPS, set to true so cookies get the Secure flag.
SESSION_COOKIE_SECURE=false
