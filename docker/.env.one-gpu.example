# Single-GPU preset — knobs read by docker-compose.one-gpu.yml.
#
# These do NOT replace your main docker/.env (which still supplies the auth
# DB password, session secret, ports, etc.). Either:
#   * copy the lines below into your existing docker/.env, or
#   * export them in your shell before running ./up.one-gpu.sh
#
# Then:   GPU=0 ./up.one-gpu.sh --build

# Physical GPU index that hosts EVERYTHING (embedder + reranker + LLM + MinerU).
# Also settable inline:  GPU=2 ./up.one-gpu.sh
GPU=0

# Lightweight Google models that coexist on one card.
ONE_GPU_EMBEDDING_MODEL=google/embeddinggemma-300m
# int4 quantization-aware-trained Gemma 3 12B. Alternatives: gemma3:12b (q4_0).
ONE_GPU_LLM_MODEL=gemma3:12b-it-qat

# REQUIRED: google/embeddinggemma-300m is a gated repo. Accept its license at
# https://huggingface.co/google/embeddinggemma-300m then create a read token
# at https://huggingface.co/settings/tokens and paste it here.
HF_TOKEN=
