# -----------------------------
# Gemma 4 31B (Transformers)
# Standalone env for docker-compose.gemma4-31b.yml
# -----------------------------

# Host service port for the Gemma API
SERVICE_PORT=8086

# Bearer token required by the local API server
LOCAL_LLM_API_KEY=local-dev-key

# Hugging Face model ID to serve
GEMMA_MODEL_ID=google/gemma-4-31b-it

# Exposed model name for OpenAI-compatible requests
GEMMA_MODEL_ALIAS=gemma4-31b-it

# Transformers dtype: auto | bfloat16 | float16 | float32
GEMMA_DTYPE=bfloat16

# Default generation cap when max_tokens is not passed per request
GEMMA_MAX_NEW_TOKENS=512

# Optional HF token (required for gated/private models)
HUGGING_FACE_HUB_TOKEN=

# Persistent host cache for model artifacts downloaded by transformers
HF_CACHE_DIR=/home3/davidlcs/Econ-Rag/Models/hf-cache

# Optional explicit GPU mask
NVIDIA_VISIBLE_DEVICES=2
CUDA_VISIBLE_DEVICES=2
