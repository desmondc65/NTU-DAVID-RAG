# -----------------------------
# Qwen3.5-35B-A3B (vLLM)
# Standalone env for docker-compose.qwen3.5-35b-a3b.yml
# -----------------------------

# Hugging Face model repo to serve
QWEN_MODEL_ID=Qwen/Qwen3.5-35B-A3B

# Exposed model alias in OpenAI-compatible API
QWEN_MODEL_ALIAS=qwen3.5-35b-a3b

# Host path where model files are stored (download script writes here)
QWEN_MODEL_DIR=/home3/davidlcs/Econ-Rag/Models/Qwen3.5-35B-A3B

# Host path for Hugging Face cache
HF_CACHE_DIR=/home3/davidlcs/Econ-Rag/Models/hf-cache

# Service port exposed on host
QWEN_SERVICE_PORT=8090

# API key for OpenAI-compatible endpoint
LOCAL_LLM_API_KEY=local-dev-key

# Multi-GPU controls
QWEN_NVIDIA_VISIBLE_DEVICES=1,2
QWEN_CUDA_VISIBLE_DEVICES=1,2
QWEN_TENSOR_PARALLEL_SIZE=2

# Runtime tuning
QWEN_DTYPE=bfloat16
QWEN_MAX_MODEL_LEN=65536
QWEN_GPU_MEMORY_UTILIZATION=0.92
QWEN_MAX_NUM_SEQS=16
